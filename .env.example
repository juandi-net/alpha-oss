# `alpha setup` copies this to .env (git-ignored). Fill in what your sources and features need.

# Claude (summaries, reasons, briefs, the judge, skills): an Anthropic API key from https://console.anthropic.com.
ALPHA_CLAUDE_API_KEY=
# Optional: another Messages API endpoint, e.g. a local CLIProxyAPI serving a Claude subscription
# (http://127.0.0.1:8317). Unset: api.anthropic.com.
ALPHA_CLAUDE_BASE_URL=

# TypeSafe (Jev: categories, duplicates, relevance, the judge): https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Source x: your X session, for reading your bookmarks in a headless browser (no X API, no cost). Open x.com
# logged in, then DevTools > Application > Cookies > https://x.com and copy the auth_token and ct0 values.
# They last until you log out of that browser session.
X_AUTH_TOKEN=
X_CT0=

# Source substack_following: your Substack session, for listing the publications you subscribe to. Open substack.com
# logged in, then DevTools > Application > Cookies > https://substack.com and copy the substack.sid value. Alpha sends
# it only to substack.com, once per run; everything else is read without it.
SUBSTACK_SID=

# Source github_stars: only needed without the GitHub CLI (`gh auth login`). A token that can read your stars.
GITHUB_TOKEN=

# Sources hf_likes and hf_following: only needed without `hf auth login` (which saves ~/.cache/huggingface/token).
# A read token from https://huggingface.co/settings/tokens.
HF_TOKEN=
